#Max Vowels in Substring of Size K
#Given a string and window size k, find the maximum number of vowels
#in any substring of size k.

s = "abciiidef"
k = 3
#Output: 3  ("iii" has 3 vowels)

def count_vowel(s,k):
    left = 0
    vowel = 'aeiou' 
    current_vowel = 0
    for c in s[0:k]:
        if c in vowel:
            current_vowel += 1
    max_vowels = current_vowel

    for right in range(k, len(s)):
        if s[right] in vowel:
            current_vowel +=1

        max_vowels = max(max_vowels, current_vowel)
        if s[left] in vowel:
            current_vowel -= 1
        left +=1
    return max_vowels
print(count_vowel(s,k))
        
